{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "r2-media-stash",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-24",
	"upload_source_maps": true,
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"routes": [
		{
			"pattern": "vybe.mottazen.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "r2-media-stash"
		}
	],
}
