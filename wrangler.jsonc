{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-media-stash",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "r2-media-stash"
    }
  ]
}
